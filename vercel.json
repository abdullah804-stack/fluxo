{
  "fluid": true,
  "functions": {
    "app/api/whatsapp/webhook/route.ts": {
      "maxDuration": 300
    },
    "app/api/messages/[id]/draft/route.ts": {
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/cron/weekly",
      "schedule": "0 4 * * 1"
    },
    {
      "path": "/api/cron/draft-expiry",
      "schedule": "0 0 * * *"
    }
  ]
}