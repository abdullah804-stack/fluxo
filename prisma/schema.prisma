generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  passwordHash  String?
  image         String?
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts        Account[]
  sessions        Session[]
  baseCurrency  String  @default("USD")
  whatsappAccount WhatsAppAccount?
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
model WhatsAppAccount {
  id              String    @id @default(cuid())
  userId          String    @unique
  phoneNumber     String    @unique
  phoneNumberId   String
  wabaId          String
  displayName     String?
  connectedAt     DateTime  @default(now())

  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages Message[]
  customers Customer[]
  orders   Order[]

  @@index([userId])
}

model Message {
  id                String   @id @default(cuid())
  whatsappAccountId String
  waMessageId       String   @unique
  direction         String
  fromNumber        String
  toNumber          String
  type              String
  content           String?  @db.Text
  mediaUrl          String?
  mediaId           String?
  rawPayload        Json
  extractedData     Json?
  createdAt         DateTime @default(now())

  account WhatsAppAccount @relation(fields: [whatsappAccountId], references: [id], onDelete: Cascade)

  @@index([whatsappAccountId, createdAt])
  @@index([fromNumber])
}
model Customer {
  id                String   @id @default(cuid())
  whatsappAccountId String
  name              String?
  phone             String
  address           String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  account WhatsAppAccount @relation(fields: [whatsappAccountId], references: [id], onDelete: Cascade)
  orders  Order[]

  @@unique([whatsappAccountId, phone])
  @@index([whatsappAccountId])
}

model Order {
  id                String   @id @default(cuid())
  whatsappAccountId String
  customerId        String
  items             Json
  total             Float?
  currency          String?
  paymentMethod     String?
  paymentStatus     String   @default("unpaid")
  address           String?
  status            String   @default("pending")
  sourceMessageId   String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  originalAmount   Float?
  originalCurrency String?
  baseAmount       Float?
  exchangeRate     Float?
  exchangeRateDate DateTime?
  recipientName     String?

  account  WhatsAppAccount @relation(fields: [whatsappAccountId], references: [id], onDelete: Cascade)
  customer Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([whatsappAccountId, status])
  @@index([whatsappAccountId, paymentStatus])
  @@index([customerId])
}
model ExchangeRate {
  id        String   @id @default(cuid())
  fromCode  String
  toCode    String
  rate      Float
  fetchedAt DateTime @default(now())

  @@unique([fromCode, toCode])
  @@index([fromCode, toCode, fetchedAt])
}